# ── Aureus Pro Environment Variables ─────────────────────────────────────────
# Copy this file to `.env` and fill in values. `.env` is gitignored — never commit it.

# Server
PORT=10000
NODE_ENV=development

# FRED real yields (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
# Used for DGS10 − T10YIE computed real yield. If empty, the CSV fallback tier
# is used automatically.
FRED_API_KEY=

# Optional keys (previously for the Floor Strategist AI commentary — now unused,
# kept only for forward compatibility). Can be left empty.
GEMINI_API_KEY=
OPENROUTER_API_KEY=